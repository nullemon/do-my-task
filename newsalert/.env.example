# Copy to .env and fill in. Never commit .env. Values here are never logged
# (anything whose name ends in KEY/TOKEN/SECRET/PASSWORD is redacted from logs).

# --- Paths (optional) ---
# NEWSALERT_HOME=/opt/newsalert          # project root; default = this folder
# NEWSALERT_CONFIG=/opt/newsalert/config # config dir; default = $NEWSALERT_HOME/config

# --- Alerts (step 2) ---
# ntfy: use ntfy.sh with a long random topic name (it acts like a password).
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
# ntfy = send to ntfy only (VM). local = sound + OS notification on this machine.
# both = do both.
ALERT_MODE=ntfy

# --- Anthropic (step 3) ---
ANTHROPIC_API_KEY=

# --- X API (step 6; leave empty = X watcher disabled) ---
X_BEARER_TOKEN=
